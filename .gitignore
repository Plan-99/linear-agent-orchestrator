data/
artifacts/
work/
logs/
.runtime/*
!.runtime/data/
!.runtime/work/
!.runtime/artifacts/
!.runtime/logs/
.runtime/data/*
.runtime/work/*
.runtime/artifacts/*
.runtime/logs/*
.runtime/agent-home/*
!.runtime/data/.gitkeep
!.runtime/work/.gitkeep
!.runtime/artifacts/.gitkeep
!.runtime/logs/.gitkeep

# Secrets and local-only env files
.env
.env.*
!.env.example
.docker-secrets/
