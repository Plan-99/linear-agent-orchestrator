# Copy to .env in this project root. Keep .env uncommitted and run
# chmod 600 .env before adding credentials.
APP_ENV=local
LOG_LEVEL=INFO
LOG_FORMAT=json
# Container path supplied by Compose and bind-mounted from this checkout's
# .runtime/data. Raw/native CLI runs must pass a host-appropriate path instead.
STATE_DB_PATH=/workspace/data/state.sqlite3
# Interactive agent console (tmux). true makes ./run.sh enter a checkout-specific
# host tmux session when launched from a foreground terminal; window 0 runs the
# daemon and each claimed issue opens a focused TUI window. Set auto to enable
# only when already inside tmux, or false for headless one-shot execution. The
# per-run lifecycle JSONL + output.log are written under AGENT_CONSOLE_LOG_DIR,
# which Compose bind-mounts from the host .runtime/logs/console.
AGENT_CONSOLE=true
# Automatically create/attach the outer host tmux session for a foreground
# terminal. Redirected/service runs never auto-allocate a TTY; they remain
# manually attachable through scripts/console-attach.sh.
AGENT_CONSOLE_AUTO_TMUX=true
AGENT_CONSOLE_LOG_DIR=/workspace/logs/console
# Whether the console may send keystrokes to the agent. False unless the adapter
# actually reads an interactive PTY; bundled one-shot omx/codex/claude default
# false, but any interactive/custom harness can opt in.
AGENT_CONSOLE_DIRECT_INPUT=false
AGENT_CONSOLE_SOCKET_DIR=/tmp/lao-console
# Where each agent run opens in the host tmux: "window" (default; daemon keeps
# window 0 and each run gets its own window, so team-mode backends can split
# panes inside it) or "split" (sibling pane in the daemon's window).
AGENT_CONSOLE_OPEN_TARGET=window
# Switch the tmux client to the newly opened run window/pane (default true).
# Set false to keep focus where you are while runs open in the background.
AGENT_CONSOLE_FOCUS=true
# Split mode only: window layout re-applied when a run pane opens, keeping the
# daemon (first pane) as the main pane. One of main-vertical | main-horizontal
# | tiled | even-vertical | even-horizontal | none.
AGENT_CONSOLE_LAYOUT=main-vertical
# Optional: override the HOST console directory bind-mounted at
# /workspace/logs/console (defaults to this checkout's .runtime/logs/console).
# LAO_RUNTIME_DIR is internal path-translation plumbing; do not set it in .env.
# AGENT_CONSOLE_HOST_LOG_DIR=/absolute/host/path/to/logs/console

# Host user identity for the container. bootstrap.sh fills these from the
# owner of this checkout so bind-mounted files are never written as root.
LAO_UID=1000
LAO_GID=1000

# Exactly one fixed, trusted repository is mounted read-write at
# /workspace/project. Defaults to this orchestrator checkout; set an absolute
# host path to point the daemon at the repository it should work on.
# LAO_PROJECT_DIR=/absolute/host/path/to/trusted-repo

# Full-host Docker development mode. When true, the agent receives the host
# Docker socket and can build/run sibling project containers. This is
# intentionally false by default: Docker API access is equivalent to host root
# and lets a trusted agent inspect LAO, other containers, and host files.
LAO_DOCKER_HOST=false
# Optional nonstandard host socket path.
# LAO_DOCKER_SOCKET=/var/run/docker.sock
#
# GUI windows still belong to the sibling project container. The Docker bridge
# forwards DISPLAY/XAUTHORITY path metadata so that project Compose files can
# mount /tmp/.X11-unix and the host Xauthority file when needed.

# Linear authentication. Choose exactly one credential set; never commit real
# values. api_key is the backward-compatible default.
LINEAR_AUTH_MODE=oauth_client_credentials
LINEAR_API_KEY=
# Recommended for daemon/service operation: create a private Linear OAuth2 app,
# enable Client Credentials, then switch LINEAR_AUTH_MODE and fill these values.
# Client Credentials uses the LAO app as mutation actor, not the human assignee.
LINEAR_OAUTH_CLIENT_ID=837fbd003869b04e677ea27e3f647b9d
LINEAR_OAUTH_CLIENT_SECRET=5d6369bca5820b09eb615cdac39da60f
LINEAR_TEAM_ID=DEV
# Only issues assigned to this Linear user are polled. Required in
# oauth_client_credentials mode so the app viewer is never mistaken for the
# human owner. In api_key mode, empty means the API-key owner.
# LINEAR_ASSIGNEE_ID=
LINEAR_PROJECT_NAME=TEST
# LINEAR_PROJECT_ID=
LINEAR_QUEUE_STATE_NAME=Todo
LINEAR_IN_PROGRESS_STATE_NAME=In Progress
LINEAR_DONE_STATE_NAME=Done
# 실패/timeout/fail-in-doubt run을 사람 검토 큐로 보내는 상태입니다.
LINEAR_ATTENTION_STATE_NAME="In Review"

# Agent runner command. The wrapper feeds the prompt to the selected CLI over
# stdin and receives the orchestrator-owned structured-result destination as
# its second argument (exported to backends as LAO_RESULT_PATH).
RUNNER_COMMAND_TEMPLATE='/usr/local/bin/lao-agent-runner {prompt_path} {result_path}'
# Set false to disable all backend execution deadlines: the one-shot timeout,
# interactive idle timeout, and interactive hard lifetime cap. A stuck backend
# can then occupy its worker slot indefinitely and must be stopped explicitly.
RUNNER_TIMEOUT_ENABLED=false
# One-shot runs: fixed deadline. Interactive runs: idle timeout — console
# output activity keeps pushing the deadline back. Ignored when timeout is off.
RUNNER_TIMEOUT_SECONDS=3600
# Interactive-only hard cap (seconds): ends the run regardless of activity so
# idle-timeout resets can never extend it forever. Ignored when timeout is off.
# Default 21600 = 6h.
RUNNER_MAX_LIFETIME_SECONDS=21600
RUNNER_WORK_DIR=/workspace/work
RUNNER_ARTIFACTS_DIR=/workspace/artifacts
RUNNER_ALLOWED_ENV=PATH,HOME,CODEX_HOME,AGENT_BACKEND,AGENT_MODEL,AGENT_EFFORT,AGENT_PROJECT_DIR,AGENT_SANDBOX,AGENT_PERMISSION_MODE,AGENT_BYPASS_PERMISSIONS,DOCKER_HOST,DISPLAY,XAUTHORITY,LAO_HOST_PROJECT_DIR,LAO_HOST_RUNTIME_DIR,LAO_HOST_X11_SOCKET_DIR
# Backend CLI: omx (oh-my-codex wrapper) | codex (OpenAI Codex CLI) | claude (Claude Code)
AGENT_BACKEND=claude
# Representative model per backend — omx/codex: gpt-5.6-sol, claude: claude-fable-5
AGENT_MODEL=claude-fable-5
# Reasoning effort (empty = backend default).
# omx/codex accept minimal|low|medium|high|xhigh (-c model_reasoning_effort=...);
# claude accepts low|medium|high|xhigh|max (--effort ...).
AGENT_EFFORT=max
AGENT_PROJECT_DIR=/workspace/project
# Per-run git worktree isolation (standard wrapper only). Source worktrees are
# intentionally separate from RUNNER_WORK_DIR scratch data. In ordinary
# Compose mode this is the backward-compatible container path; Docker-host mode
# translates it to the target repo's host sibling (<target>-worktrees).
AGENT_WORKTREE_ROOT=/workspace/work/worktrees
# Pin every issue branch to an explicit stable ref instead of the base
# checkout's current HEAD.
AGENT_BASE_REF=main
# Successful runs commit to local lao/<issue>-<key> branches (never pushed).
# The base checkout stays clean. Set false for legacy fixed-directory mode
# (which then requires a clean worktree before every run).
AGENT_WORKTREE_ISOLATION=true
# Interactive conversation mode: run the backend TUI inside the per-run tmux
# console with the issue prompt as the first message; the operator can type in
# the console pane. By default, writing result.json does not close the TUI; the
# run completes when the operator/backend exits the TUI. RUNNER_TIMEOUT_SECONDS
# is a backstop only when RUNNER_TIMEOUT_ENABLED=true. Requires AGENT_CONSOLE
# and is best used with MAX_PARALLEL_RUNS=1.
AGENT_INTERACTIVE=true
# Legacy behavior: close the interactive TUI as soon as a valid result.json is
# detected. Keep false to let the operator review output and exit manually.
AGENT_INTERACTIVE_AUTOCLOSE=false
# Concurrent issue workers inside this one daemon. Each worker claims its own
# issue via SQLite leases; >1 requires AGENT_WORKTREE_ISOLATION=true. Keep
# POLL_INTERVAL_SECONDS >= 15 with multiple workers to respect Linear's
# ~1500 req/h API-key budget.
MAX_PARALLEL_RUNS=2
POLL_INTERVAL_SECONDS=15
# Docker/Compose is the security boundary; agent CLIs run with permissions
# bypassed inside the container. Set false to fall back to backend-native
# sandbox/permission modes below.
AGENT_BYPASS_PERMISSIONS=true
AGENT_SANDBOX=workspace-write
AGENT_PERMISSION_MODE=acceptEdits
